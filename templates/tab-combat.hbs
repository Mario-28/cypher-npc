{{!-- COMBAT tab: vitals + primary attacks + secondary attacks + defenses + tactics. --}}
<section class="tab cne-tab-combat {{tab.cssClass}}" data-group="primary" data-tab="combat">
  {{#unless limited}}
  <div class="cne-column">

    {{!-- Vitals: health, damage, armor, initiative --}}
    <fieldset class="cne-panel">
      <legend class="cne-ribbon">{{localize "CNE.Combat.Vitals"}}</legend>

      <div class="cne-vitals">
        <div class="cne-health-box">
          <label class="cne-label" for="cne-health-{{actor.id}}">{{localize "CNE.Combat.Health"}}</label>
          <div class="cne-health-controls">
            {{#if editable}}
            <button type="button" class="cne-icon-btn" data-action="adjustHealth" data-delta="-1"
                    data-tooltip="CNE.Combat.DecreaseHealth" aria-label="{{localize 'CNE.Combat.DecreaseHealth'}}">
              <i class="fa-solid fa-minus" inert></i>
            </button>
            {{/if}}
            <input id="cne-health-{{actor.id}}" class="cne-input cne-health-value" type="number"
                   name="system.pools.health.value" value="{{system.pools.health.value}}" min="0" step="1">
            <span class="cne-health-sep">/</span>
            <input class="cne-input cne-health-max" type="number"
                   name="system.pools.health.max" value="{{system.pools.health.max}}" min="0" step="1"
                   aria-label="{{localize 'CNE.Combat.Health'}} max">
            {{#if editable}}
            <button type="button" class="cne-icon-btn" data-action="adjustHealth" data-delta="1"
                    data-tooltip="CNE.Combat.IncreaseHealth" aria-label="{{localize 'CNE.Combat.IncreaseHealth'}}">
              <i class="fa-solid fa-plus" inert></i>
            </button>
            <button type="button" class="cne-icon-btn" data-action="resetHealth"
                    data-tooltip="CNE.Combat.ResetHealth" aria-label="{{localize 'CNE.Combat.ResetHealth'}}">
              <i class="fa-solid fa-rotate" inert></i>
            </button>
            {{/if}}
          </div>
        </div>

        <div class="cne-grid-3">
          <div class="cne-field">
            <label class="cne-label" for="cne-damage-{{actor.id}}">{{localize "CNE.Combat.Damage"}}</label>
            <input id="cne-damage-{{actor.id}}" class="cne-input" type="number"
                   name="system.combat.damage" value="{{system.combat.damage}}" min="0" step="1">
          </div>
          <div class="cne-field">
            <label class="cne-label" for="cne-armor-{{actor.id}}">{{localize "CNE.Combat.Armor"}}</label>
            <input id="cne-armor-{{actor.id}}" class="cne-input" type="number"
                   name="system.combat.armor" value="{{system.combat.armor}}" min="0" step="1">
          </div>
          <div class="cne-field">
            <label class="cne-label" for="cne-init-{{actor.id}}">{{localize "CNE.Combat.InitiativeBonus"}}</label>
            <input id="cne-init-{{actor.id}}" class="cne-input" type="number"
                   name="system.settings.general.initiativeBonus" value="{{system.settings.general.initiativeBonus}}" step="1">
          </div>
        </div>
      </div>
    </fieldset>

    {{!-- Primary Attacks --}}
    <section class="cne-item-section" data-drop-zone="primary" aria-label="{{localize 'CNE.Combat.PrimaryAttacks'}}">
      <header class="cne-section-header">
        <h3 class="cne-section-title">{{localize "CNE.Combat.PrimaryAttacks"}}</h3>
        <span class="cne-count">{{itemGroups.primaryAttacks.length}}</span>
        {{#if editable}}
        <button type="button" class="cne-icon-btn" data-action="itemCreate" data-type="attack" data-subtype="primary"
                data-tooltip="CNE.Items.Create" aria-label="{{localize 'CNE.Items.Create'}}">
          <i class="fa-solid fa-plus" inert></i>
        </button>
        {{/if}}
      </header>

      <ul class="cne-item-list">
        {{#each itemGroups.primaryAttacks}}
        <li class="cne-item draggable" draggable="true" data-item-id="{{id}}">
          <img class="cne-item-img" src="{{img}}" alt="">
          <div class="cne-item-text">
            <span class="cne-item-name">{{name}}</span>
            {{#if attackStats}}
            <div class="cne-attack-stats">
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.AttackLevel'}}">
                <i class="fa-solid fa-layer-group" inert></i> {{attackStats.level}}
              </span>
              <span class="cne-attack-stat {{#if (gt attackStats.bonusPenalty 0)}}cne-bonus{{else if (lt attackStats.bonusPenalty 0)}}cne-penalty{{/if}}" title="{{localize 'CNE.Combat.AttackBonusPenalty'}}">
                <i class="fa-solid fa-scale-balanced" inert></i> {{attackStats.bonusPenaltySign}}
              </span>
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.AttackDamage'}}">
                <i class="fa-solid fa-heart-crack" inert></i> {{attackStats.damage}}
              </span>
              {{#if abilities}}
              {{#each abilities}}
              <div class="cne-ability-icon" data-ability-id="{{id}}" data-ability-uuid="{{uuid}}">
                <img src="{{img}}" alt="{{name}}">
                <div class="cne-ability-tooltip">
                  <div class="cne-ability-tooltip-header">
                    <img src="{{img}}" alt="">
                    <span class="cne-ability-tooltip-name">{{name}}</span>
                  </div>
                  {{#if attackBonus}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-sword"></i> Bonus: {{attackBonus}}</div>
                  {{/if}}
                  {{#if damage}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-heart-crack"></i> Damage: {{damage}}</div>
                  {{/if}}
                  {{#if range}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-bullseye"></i> Range: {{range}}</div>
                  {{/if}}
                  {{#if duration}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-hourglass-half"></i> Duration: {{duration}}</div>
                  {{/if}}
                  {{#if pool}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-droplet"></i> Pool: {{pool}} {{poolValue}}</div>
                  {{/if}}
                  {{#if description}}
                  <div class="cne-ability-tooltip-desc">{{{description}}}</div>
                  {{/if}}
                </div>
              </div>
              {{/each}}
              {{/if}}
            </div>
            {{/if}}
            {{#if detail}}<span class="cne-item-detail">{{detail}}</span>{{/if}}
          </div>
          <div class="cne-item-controls">
            {{#if @root.editable}}
            <button type="button" class="cne-icon-btn cne-danger" data-action="itemDelete"
                    data-tooltip="CNE.Items.Delete" aria-label="{{localize 'CNE.Items.Delete'}}">
              <i class="fa-solid fa-trash" inert></i>
            </button>
            {{/if}}
          </div>
        </li>
        {{else}}
        <li class="cne-empty">{{localize "CNE.Action.DropHint"}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Secondary Attacks --}}
    <section class="cne-item-section" data-drop-zone="secondary" aria-label="{{localize 'CNE.Combat.SecondaryAttacks'}}">
      <header class="cne-section-header">
        <h3 class="cne-section-title">{{localize "CNE.Combat.SecondaryAttacks"}}</h3>
        <span class="cne-count">{{itemGroups.secondaryAttacks.length}}</span>
        {{#if editable}}
        <button type="button" class="cne-icon-btn" data-action="itemCreate" data-type="attack" data-subtype="secondary"
                data-tooltip="CNE.Items.Create" aria-label="{{localize 'CNE.Items.Create'}}">
          <i class="fa-solid fa-plus" inert></i>
        </button>
        {{/if}}
      </header>

      <ul class="cne-item-list">
        {{#each itemGroups.secondaryAttacks}}
        <li class="cne-item draggable" draggable="true" data-item-id="{{id}}">
          <img class="cne-item-img" src="{{img}}" alt="">
          <div class="cne-item-text">
            <span class="cne-item-name">{{name}}</span>
            {{#if attackStats}}
            <div class="cne-attack-stats">
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.AttackLevel'}}">
                <i class="fa-solid fa-layer-group" inert></i> {{attackStats.level}}
              </span>
              <span class="cne-attack-stat {{#if (gt attackStats.bonusPenalty 0)}}cne-bonus{{else if (lt attackStats.bonusPenalty 0)}}cne-penalty{{/if}}" title="{{localize 'CNE.Combat.AttackBonusPenalty'}}">
                <i class="fa-solid fa-scale-balanced" inert></i> {{attackStats.bonusPenaltySign}}
              </span>
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.AttackDamage'}}">
                <i class="fa-solid fa-heart-crack" inert></i> {{attackStats.damage}}
              </span>
              {{#if abilities}}
              {{#each abilities}}
              <div class="cne-ability-icon" data-ability-id="{{id}}" data-ability-uuid="{{uuid}}">
                <img src="{{img}}" alt="{{name}}">
                <div class="cne-ability-tooltip">
                  <div class="cne-ability-tooltip-header">
                    <img src="{{img}}" alt="">
                    <span class="cne-ability-tooltip-name">{{name}}</span>
                  </div>
                  {{#if attackBonus}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-sword"></i> Bonus: {{attackBonus}}</div>
                  {{/if}}
                  {{#if damage}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-heart-crack"></i> Damage: {{damage}}</div>
                  {{/if}}
                  {{#if range}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-bullseye"></i> Range: {{range}}</div>
                  {{/if}}
                  {{#if duration}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-hourglass-half"></i> Duration: {{duration}}</div>
                  {{/if}}
                  {{#if pool}}
                  <div class="cne-ability-tooltip-stat"><i class="fa-solid fa-droplet"></i> Pool: {{pool}} {{poolValue}}</div>
                  {{/if}}
                  {{#if description}}
                  <div class="cne-ability-tooltip-desc">{{{description}}}</div>
                  {{/if}}
                </div>
              </div>
              {{/each}}
              {{/if}}
            </div>
            {{/if}}
            {{#if detail}}<span class="cne-item-detail">{{detail}}</span>{{/if}}
          </div>
          <div class="cne-item-controls">
            {{#if @root.editable}}
            <button type="button" class="cne-icon-btn cne-danger" data-action="itemDelete"
                    data-tooltip="CNE.Items.Delete" aria-label="{{localize 'CNE.Items.Delete'}}">
              <i class="fa-solid fa-trash" inert></i>
            </button>
            {{/if}}
          </div>
        </li>
        {{else}}
        <li class="cne-empty">{{localize "CNE.Action.DropHint"}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Defenses --}}
    <section class="cne-item-section" data-drop-zone="defense" aria-label="{{localize 'CNE.Combat.Defenses'}}">
      <header class="cne-section-header">
        <h3 class="cne-section-title">{{localize "CNE.Combat.Defenses"}}</h3>
        <span class="cne-count">{{itemGroups.defenses.length}}</span>
        {{#if editable}}
        <button type="button" class="cne-icon-btn" data-action="itemCreate" data-type="attack" data-subtype="defense"
                data-tooltip="CNE.Items.Create" aria-label="{{localize 'CNE.Items.Create'}}">
          <i class="fa-solid fa-plus" inert></i>
        </button>
        {{/if}}
      </header>

      <ul class="cne-item-list">
        {{!-- Default defense (always shown) --}}
        <li class="cne-item cne-default-defense {{#if (eq activeDefense 'default')}}cne-defense-active{{/if}}">
          <label class="cne-defense-check" title="{{localize 'CNE.Combat.ActiveDefense'}}">
            <input type="checkbox" class="cne-defense-checkbox" data-defense-id="default" {{#if (eq activeDefense 'default')}}checked{{/if}}>
            <span class="cne-checkmark"><i class="fa-solid fa-shield-halved"></i></span>
          </label>
          <div class="cne-item-text">
            <span class="cne-item-name">{{localize "CNE.Combat.DefaultDefense"}}</span>
            <div class="cne-attack-stats">
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.NpcLevel'}}">
                <i class="fa-solid fa-layer-group" inert></i> {{system.basic.level}}
              </span>
              <span class="cne-attack-stat" title="{{localize 'CNE.Combat.DefenseBonusPenalty'}}">
                <i class="fa-solid fa-scale-balanced" inert></i> +0
              </span>
              <span class="cne-attack-stat cne-armor-stat" title="{{localize 'CNE.Combat.ArmorRating'}}">
                <i class="fa-solid fa-shield" inert></i> {{system.combat.armor}}
              </span>
            </div>
          </div>
        </li>
        {{#each itemGroups.defenses}}
        <li class="cne-item draggable {{#if (eq @root.activeDefense id)}}cne-defense-active{{/if}}" draggable="true" data-item-id="{{id}}">
          <label class="cne-defense-check" title="{{localize 'CNE.Combat.ActiveDefense'}}">
            <input type="checkbox" class="cne-defense-checkbox" data-defense-id="{{id}}" {{#if (eq @root.activeDefense id)}}checked{{/if}}>
            <span class="cne-checkmark"><i class="fa-solid fa-shield-halved"></i></span>
          </label>
          <img class="cne-item-img" src="{{img}}" alt="">
          <div class="cne-item-text">
            <span class="cne-item-name">{{name}}</span>
            {{#if defenseStats}}
            <div class="cne-attack-stats">
              <span class="cne-attack-stat cne-armor-stat" title="{{localize 'CNE.Combat.ArmorRating'}}">
                <i class="fa-solid fa-shield" inert></i> {{defenseStats.armorRating}}
              </span>
              <span class="cne-attack-stat {{#if (gt defenseStats.armorModNpc 0)}}cne-bonus{{/if}}" title="{{localize 'CNE.Combat.DefenseBonusPenalty'}}">
                <i class="fa-solid fa-scale-balanced" inert></i> {{#if (gt defenseStats.armorModNpc 0)}}+{{/if}}{{defenseStats.armorModNpc}}
              </span>
              <span class="cne-attack-stat {{#if (gt defenseStats.armorPenalty 0)}}cne-penalty{{/if}}" title="{{localize 'CNE.Combat.ArmorPenalty'}}">
                <i class="fa-solid fa-weight-hanging" inert></i> {{defenseStats.armorPenalty}}
              </span>
            </div>
            {{/if}}
            {{#if detail}}<span class="cne-item-detail">{{detail}}</span>{{/if}}
          </div>
          <div class="cne-item-controls">
            {{#if @root.editable}}
            <button type="button" class="cne-icon-btn cne-danger" data-action="itemDelete"
                    data-tooltip="CNE.Items.Delete" aria-label="{{localize 'CNE.Items.Delete'}}">
              <i class="fa-solid fa-trash" inert></i>
            </button>
            {{/if}}
          </div>
        </li>
        {{else}}
        <li class="cne-empty">{{localize "CNE.Action.DropHint"}}</li>
        {{/each}}
      </ul>
    </section>

    {{!-- Tactics notes --}}
    <fieldset class="cne-panel">
      <legend class="cne-ribbon">{{localize "CNE.Action.Tactics"}}</legend>
      <label class="cne-label cne-sr-only" for="cne-tactics-{{actor.id}}">{{localize "CNE.Action.Tactics"}}</label>
      <textarea id="cne-tactics-{{actor.id}}" class="cne-input cne-textarea" rows="5"
                name="flags.cypher-npc-elegance.tactics"
                placeholder="{{localize 'CNE.Action.TacticsPlaceholder'}}">{{flags.tactics}}</textarea>
    </fieldset>

  </div>
  {{/unless}}
</section>
